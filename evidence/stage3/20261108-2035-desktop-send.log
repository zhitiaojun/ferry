# M7 desktop relay send (2026-11-08 20:35 +08:00)

## build
$ go build ./... && go vet ./cmd/ft-desktop ./core/client
OK (no output)

## local server + receiver
$ ft-server -listen 127.0.0.1:18794
$ ft recv --signal ws://127.0.0.1:18794/signal --key .tools/keys/recv.key --paired .tools/keys/paired-recv.json --out .tools/desk-send-recv

## sender (desktop binary, same code path as the drop window)
$ .tools/bin/ft-desktop.exe -send .tools/testdata/test-2.1m.bin -key .tools/keys/send.key -paired .tools/keys/paired-send.json -signal ws://127.0.0.1:18794/signal -dir .tools/desk-recv2 -log .tools/desk-send.jsonl
{"ok":true,"to":"recv-bj","bytes":2100000,"chunks":33}

