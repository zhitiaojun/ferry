# /etc/systemd/system/ft-server.service
[Unit]
Description=filetransfer signaling and relay server (ft-server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/ft-server/ft-server -listen 127.0.0.1:18790 -log /var/log/ft-server/events.jsonl
Environment=GOMEMLIMIT=160MiB
MemoryMax=256M
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log/ft-server
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
---
server {
    listen 80;
    server_name ft.cwlindean.cn;

    access_log /www/sites/ft.cwlindean.cn/log/access.log main;
    error_log  /www/sites/ft.cwlindean.cn/log/error.log;

    # Let's Encrypt HTTP-01 (the domain resolves to ESA; ESA proxies port 80).
    location ^~ /.well-known/acme-challenge/ {
        root /www/sites/ft.cwlindean.cn/index;
        default_type text/plain;
    }

    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ft.cwlindean.cn;

    access_log /www/sites/ft.cwlindean.cn/log/access.log main;
    error_log  /www/sites/ft.cwlindean.cn/log/error.log;

    ssl_certificate     /www/sites/ft.cwlindean.cn/ssl/fullchain.pem;
    ssl_certificate_key /www/sites/ft.cwlindean.cn/ssl/privkey.pem;
    ssl_protocols TLSv1.3 TLSv1.2;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    error_page 497 https://$host$request_uri;

    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 16m;

    location = /healthz {
        proxy_pass http://127.0.0.1:18790;
        access_log off;
    }

    include /www/sites/ft.cwlindean.cn/proxy/*.conf;

    location / { return 204; }
}
---
# Long-lived WebSocket endpoints: signaling and relay splicing (protocol §8).
#
# Both are proxied to the loopback-only ft-server. WebSocket upgrade headers and
# long read timeouts are required: the relay keeps an idle connection for up to
# 60 s and signaling heartbeats every 30 s.

location /signal {
    proxy_pass http://127.0.0.1:18790;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_buffering off;
}

location /relay {
    proxy_pass http://127.0.0.1:18790;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_buffering off;
}
